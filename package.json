{
  "name": "@commonalities/archetypes-rules",
  "description": "Move conditional logic out of source code and database triggers and into a reusable package, where explicit rules can be independently defined and managed.",
  "type": "module",
  "version": "1.3.13",
  "author": {
    "name": "Greg Swindle",
    "url": "https://github.com/commonality"
  },
  "bugs": "https://github.com/commonality/archetypes-rules/issues",
  "commitplease": {
    "nohook": false,
    "style": "angular",
    "types": [
      "build",
      "chore",
      "ci",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ],
    "scope": "\\S+.*"
  },
  "contributors": [
    {
      "name": "Greg Swindle",
      "url": "https://github.com/gregswindle"
    }
  ],
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@sindresorhus/is": "8.1.0",
    "dotenv-extended": "3.1.0",
    "es-toolkit": "1.53.2",
    "obug": "3.0.0",
    "ow": "3.1.1"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "semantic-release": "26.0.1"
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": "12.*"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/commonality/archetypes-rules#readme",
  "jest": {
    "automock": false,
    "collectCoverage": true,
    "coveragePathIgnorePatterns": [
      "<rootDir>/.github/",
      "<rootDir>/.gitlab/",
      "<rootDir>/docs/",
      "<rootDir>/lib/*/__tests__/__fixtures__/",
      "<rootDir>/lib/*/__tests__/__mocks__/",
      "<rootDir>/node_modules"
    ],
    "coverageProvider": "v8",
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "injectGlobals": true,
    "moduleDirectories": [
      "node_modules",
      "lib"
    ],
    "testPathIgnorePatterns": [
      "/.github/rc/",
      "__fixtures__/",
      "__mocks__/",
      "/docs/",
      "/node_modules/",
      "/lib/rule.js"
    ],
    "transform": {},
    "reporters": [
      "default",
      "jest-junit"
    ],
    "watchman": false
  },
  "keywords": [
    "archetype-pattern",
    "boolean-logic",
    "facts",
    "json",
    "node",
    "node-module",
    "node.js",
    "nodejs",
    "rpn",
    "rule-context",
    "rule-engine",
    "rule-override",
    "rule-overrides",
    "rule-set",
    "rule-sets",
    "rules",
    "rules-engine"
  ],
  "license": "MIT",
  "main": "dist/archetypes-rules.mjs",
  "packageManager": "pnpm@12.23.0",
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "^14.0.6",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "readme": "https://github.com/commonality/archtypes-rules/README.md",
  "release": {
    "verifyConditions": [
      "@semantic-release/changelog",
      "@semantic-release/github",
      "@semantic-release/npm"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": [
            {
              "type": "build",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "ci",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "package.json",
              "label": "Product manifest"
            },
            {
              "path": "CHANGELOG.md",
              "label": "All product changes up-to and including this distribution"
            },
            {
              "path": "LICENSE",
              "label": "License for distribution"
            },
            {
              "path": "NOTICE.md",
              "label": "Software licenses and their obligations"
            },
            {
              "path": "README.md",
              "label": "Installation and usage instructions for distribution"
            },
            {
              "path": "SECURITY.md",
              "label": "Security policy"
            },
            {
              "path": "dist/**",
              "label": "Public API module and its private dependencies"
            }
          ]
        }
      ],
      "@semantic-release/git"
    ],
    "prepare": [
      {
        "path": "@semantic-release/changelog",
        "changelogTitle": "# Changelog"
      },
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "message": "chore(release): ${nextRelease.gitTag}"
        }
      ]
    ],
    "publish": [
      "@semantic-release/github",
      "@semantic-release/npm"
    ],
    "success": false,
    "fail": false
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/commonality/archetypes-rules.git"
  },
  "scripts": {
    "build": "pnpm bundle",
    "prebundle": "pnpm bundle:clean",
    "bundle": "pnpm dlx rollup --config",
    "postbundle": "pnpm pack",
    "bundle:clean": "rm -rf ./dist/ && rm -f *.tgz",
    "ci:audit:all": "pnpm audit --reporter ndjson --sort",
    "ci:audit:prod": "pnpm audit --no-optional --production --reporter ndjson --sort",
    "ci:check:js": "pnpm dlx @biomejs/biome ci lib/",
    "ci:outdated": "pnpm outdated --long --no-optional --prod",
    "ci:sbom": "pnpm sbom --exclude-peers --no-optional --out %s@%v.sbom.json --production --sbom-format cyclonedx",
    "ci:test": "pnpm start && node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --reporters=default --reporters=jest-junit --verbose",
    "docs:api": "pnpm dlx jsdoc -c ./.github/ci/conf/jsdoc.json ./lib/ -r -R ./README.md -P package.json",
    "preinstall": "npx only-allow pnpm",
    "no-postinstall": "gh actions-lock",
    "postuninstall": "gh actions-lock",
    "lint:js": "pnpm dlx @biomejs/biome check lib/",
    "lint:js:fix": "pnpm dlx @biomejs/biome check --write lib/",
    "lint:json:fix": "pnpm dlx prettier --write **/*.json",
    "postversion": "pnpm bundle",
    "security:audit:dependencies": "pnpm audit --dry-run",
    "semantic-release": "pnpm dlx semantic-release --no-ci",
    "start": "node -r dotenv-extended ./lib/env-config.js",
    "pretest": "pnpm lint:js:fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --verbose"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
