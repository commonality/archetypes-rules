{
  "name": "archetypes-rules",
  "description": "Move conditional logic out of source code and database triggers and into a reusable package, where explicit rules can be independently defined and managed.",
  "type": "module",
  "version": "1.3.5",
  "author": {
    "name": "Greg Swindle",
    "url": "https://github.com/commonality"
  },
  "bugs": "https://github.com/commonality/archetypes-rules/issues",
  "commitplease": {
    "nohook": false,
    "style": "angular",
    "types": [
      "build",
      "chore",
      "ci",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ],
    "scope": "\\S+.*"
  },
  "contributors": [
    {
      "name": "Greg Swindle",
      "url": "https://github.com/gregswindle"
    }
  ],
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@sindresorhus/is": "8.1.0",
    "camelcase": "10.0.0",
    "debug": "4.4.3",
    "dotenv-extended": "3.1.0",
    "fs-extra": "11.4.1",
    "lodash.get": "4.4.2",
    "lodash.hasin": "4.5.2",
    "lodash.includes": "4.3.0",
    "lodash.intersection": "4.4.0",
    "lodash.invoke": "4.5.2",
    "lodash.isequal": "4.5.0",
    "lodash.kebabcase": "4.1.1",
    "lodash.toarray": "4.4.0",
    "lodash.topairs": "4.3.0",
    "ow": "3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@jest/globals": "30.5.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "all-contributors-cli": "7.0.1",
    "better-docs": "2.7.3",
    "commitizen": "4.3.2",
    "commitplease": "3.2.0",
    "git-repo-info": "2.1.1",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "jest-sonar-reporter": "2.0.0",
    "jsdoc": "4.0.5",
    "jsdoc-mermaid": "1.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "rollup": "4.68.2",
    "semantic-release": "25.0.9"
  },
  "engines": {
    "node": ">=24 <27",
    "npm": "12.*"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/commonality/archetypes-rules#readme",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "jest": {
    "automock": false,
    "collectCoverage": true,
    "coveragePathIgnorePatterns": [
      "<rootDir>/.github/",
      "<rootDir>/.github/",
      "<rootDir>/docs/",
      "<rootDir>/lib/*/__tests__/__fixtures__/",
      "<rootDir>/lib/cli/signature-ctrl/__tests__/__fixtures__/",
      "<rootDir>/lib/*/__tests__/__mocks__/",
      "<rootDir>/node_modules",
      "<rootDir>/lib/rule.js"
    ],
    "coverageProvider": "v8",
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "injectGlobals": true,
    "moduleDirectories": [
      "node_modules",
      "lib"
    ],
    "testPathIgnorePatterns": [
      "/.github/rc/",
      "__fixtures__/",
      "__mocks__/",
      "/docs/",
      "/node_modules/",
      "/lib/rule.js"
    ],
    "transform": {},
    "reporters": [
      "default",
      "jest-junit"
    ],
    "watchman": false
  },
  "jestSonar": {
    "reportFile": "sonar-test-report.xml"
  },
  "keywords": [
    "archetype-pattern",
    "boolean-logic",
    "facts",
    "json",
    "node",
    "node-module",
    "node.js",
    "nodejs",
    "rpn",
    "rule-context",
    "rule-engine",
    "rule-override",
    "rule-overrides",
    "rule-set",
    "rule-sets",
    "rules",
    "rules-engine"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.js": [
      "npm run lint:js:fix",
      "npm run docs:api",
      "git add"
    ],
    "*.json": [
      "npm run lint:json:fix",
      "git add"
    ]
  },
  "main": "dist/archetypes-rules.mjs",
  "readme": "https://github.com/commonality/archtypes-rules/README.md",
  "release": {
    "verifyConditions": [
      "@semantic-release/changelog",
      "@semantic-release/github",
      "@semantic-release/npm"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": [
            {
              "type": "build",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "ci",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "package.json",
              "label": "Product manifest"
            },
            {
              "path": "CHANGELOG.md",
              "label": "All product changes up-to and including this distribution"
            },
            {
              "path": "LICENSE",
              "label": "License for distribution"
            },
            {
              "path": "README.md",
              "label": "Installation and usage instructions for distribution"
            },
            {
              "path": "dist/**",
              "label": "Public API module and its private dependencies"
            }
          ]
        }
      ],
      "@semantic-release/git"
    ],
    "prepare": [
      {
        "path": "@semantic-release/changelog",
        "changelogTitle": "# Changelog"
      },
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "message": "chore(release): ${nextRelease.gitTag}"
        }
      ]
    ],
    "publish": [
      "@semantic-release/github",
      "@semantic-release/npm"
    ],
    "success": false,
    "fail": false
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/commonality/archetypes-rules.git"
  },
  "scripts": {
    "build": "npm run bundle",
    "prebundle": "npm run bundle:clean",
    "bundle": "rollup --config",
    "postbundle": "npm pack",
    "bundle:clean": "rm -rf ./dist/ && rm -f *.tgz",
    "ci:audit:all": "npm audit --all",
    "ci:audit:prod": "npm audit --omit=dev",
    "ci:check:js": "npx @biomejs/biome ci lib/",
    "ci:outdated": "npm outdated --long",
    "ci:sbom": "npx --yes @cyclonedx/cyclonedx-npm --omit=dev --omit=optional --omit=peer --output-format=JSON --output-file=nodejs-package.sbom.json --validate --verbose",
    "ci:test": "npm run start && npm run ci:check:js && node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --reporters=default --reporters=jest-junit --testResultsProcessor=jest-sonar-reporter --verbose",
    "docs:api": "jsdoc ./lib/ -r -R ./README.md -P package.json -t ./node_modules/better-docs/ -d ./docs/api/",
    "lint:js": "npx @biomejs/biome check lib/",
    "lint:js:fix": "npx @biomejs/biome check --write lib/",
    "lint:json:fix": "prettier --write **/*.json",
    "postversion": "npm run bundle",
    "security:audit:dependencies": "npm audit --dry-run",
    "semantic-release": "semantic-release -ci=false",
    "start": "node -r dotenv-extended ./lib/env-config.js",
    "pretest": "npm run lint:js:fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --verbose"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "commitplease@3.2.0": true,
    "core-js@2.6.12": true,
    "fsevents@2.3.3": true
  }
}
